rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isFounder() {
      return isAuthenticated() && 
             request.auth.token.email == 'landonekatz@gmail.com';
    }

    // User profile documents in /users/{userId}
    match /users/{userId} {
      // Authenticated users can read their own profile, founder can read any profile
      allow read: if isOwner(userId) || isFounder();

      // Authenticated users can create or update their own profile, founder can write any profile
      allow write: if isOwner(userId) || isFounder();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
