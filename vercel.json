{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/dmsfantasy", "destination": "/dmsfantasy/index.html" },
    { "source": "/dmsfantasy/(.*)", "destination": "/dmsfantasy/index.html" },
    { "source": "/gaywoodfantasy", "destination": "/gaywoodfantasy/index.html" },
    { "source": "/gaywoodfantasy/(.*)", "destination": "/gaywoodfantasy/index.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/([a-zA-Z0-9_-]+)", "destination": "/vault.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
